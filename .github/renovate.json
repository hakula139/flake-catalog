{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>hakula139/devkit#v3"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)flake\\.nix$/"],
      "matchStrings": ["github:hakula139/(?<depName>[^/\"]+)/(?<currentValue>v\\d+\\.[^\"\\s]+)"],
      "depNameTemplate": "hakula139/{{depName}}",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["flake.nix"],
      "automerge": false
    }
  ]
}
